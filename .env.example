# API Configuration (OpenAI-compatible endpoints)
# Get your key from https://openrouter.ai or any other provider
VOICE2TEXT_API_KEY=sk-or-v1-your-key-here

# API endpoint URL (must expose an OpenAI-compatible /chat/completions API)
VOICE2TEXT_API_URL=https://openrouter.ai/api/v1

# Model to use (use full model ID for OpenRouter)
VOICE2TEXT_MODEL=google/gemini-3-flash-preview

# Start/stop hotkey (f1-f13, or insert on external keyboards)
VOICE2TEXT_HOTKEY=f13
